<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/sc_expense_short"
        android:shortcutLongLabel="@string/sc_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="familymoney://add?type=Expense"
            android:targetClass="com.familymoney.app.MainActivity"
            android:targetPackage="com.familymoney.app" />
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/sc_income_short"
        android:shortcutLongLabel="@string/sc_income_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="familymoney://add?type=Income"
            android:targetClass="com.familymoney.app.MainActivity"
            android:targetPackage="com.familymoney.app" />
    </shortcut>
</shortcuts>
